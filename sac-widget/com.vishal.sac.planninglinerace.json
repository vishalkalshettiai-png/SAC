{
  "id": "com.vishal.sac.planninglinerace",
  "version": "1.0.1",
  "name": "Planning Line Race Table",
  "description": "Editable SAC planning table with Apache ECharts line-race visualization. Use the Builder panel to bind a planning model and assign dimensions/measures to rows and columns.",
  "newInstancePrefix": "PlanningLineRace",
  "icon": "data:image/svg+xml;base64,",
  "vendor": "Vishal Kalshetti",
  "eula": "",
  "license": "Apache-2.0",
  "imports": ["table"],
  "supportsMobile": true,
  "supportsExport": false,
  "supportsLinkedAnalysisFilterOnSelection": true,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-vishal-sac-planninglinerace",
      "url": "/planningTable.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-vishal-sac-planninglinerace-styling",
      "url": "/planningTable_styling.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Widget title",
      "default": "Planning Line Race"
    },
    "showTitle": {
      "type": "boolean",
      "description": "Show the widget title",
      "default": true
    },
    "viewMode": {
      "type": "string",
      "description": "Display mode: split, table, or chart",
      "default": "split"
    },
    "editable": {
      "type": "boolean",
      "description": "Allow users to type values into table cells and write back to the planning model",
      "default": true
    },
    "animationDuration": {
      "type": "integer",
      "description": "Line race animation duration in milliseconds",
      "default": 10000
    },
    "primaryColor": {
      "type": "string",
      "description": "Accent color",
      "default": "#0854a0"
    },
    "backgroundColor": {
      "type": "string",
      "description": "Background color",
      "default": "#ffffff"
    },
    "width": {
      "type": "integer",
      "default": 880
    },
    "height": {
      "type": "integer",
      "default": 620
    }
  },
  "methods": {
    "setTitle": {
      "description": "Sets the widget title",
      "parameters": [
        { "name": "newTitle", "type": "string", "description": "Title text" }
      ],
      "body": "this.title = newTitle;"
    },
    "getTitle": {
      "description": "Returns the widget title",
      "returnType": "string",
      "body": "return this.title;"
    },
    "setViewMode": {
      "description": "Sets display mode: split, table, or chart",
      "parameters": [
        { "name": "mode", "type": "string", "description": "split, table, or chart" }
      ],
      "body": "this.viewMode = mode;"
    },
    "setDataSource": {
      "description": "Provides a planning DataSource for write-back (optional if the bound model already exposes it)",
      "parameters": [
        { "name": "dataSource", "type": "DataSource", "description": "SAC DataSource from a planning model" }
      ]
    },
    "getDataSource": {
      "description": "Returns the planning DataSource used for write-back",
      "returnType": "DataSource"
    },
    "submitPlanningData": {
      "description": "Submits pending cell edits to the planning model",
      "returnType": "boolean"
    },
    "revertPlanningData": {
      "description": "Reverts pending cell edits"
    },
    "getEventInfo": {
      "description": "Returns details of the last cell change or selection",
      "returnType": "string"
    },
    "getPendingEditsCount": {
      "description": "Returns the number of unsaved cell edits",
      "returnType": "integer"
    }
  },
  "events": {
    "onCellChange": {
      "description": "Fired when a user edits a planning cell"
    },
    "onSubmit": {
      "description": "Fired after planning data is submitted"
    },
    "onSelect": {
      "description": "Fired when a table cell or chart series is selected"
    }
  },
  "dataBindings": {
    "planningData": {
      "feeds": [
        {
          "id": "rows",
          "description": "Rows (series / line-race entities)",
          "type": "dimension"
        },
        {
          "id": "columns",
          "description": "Columns (time axis for the line race)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures (editable planning values)",
          "type": "mainStructureMember"
        }
      ]
    }
  }
}
